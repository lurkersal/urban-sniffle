<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IndexEditor.Views"
             x:Class="IndexEditor.Views.PageControllerView"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <local:ArticleCategoryToColorConverter x:Key="ArticleCategoryToColorConverter" />
    </UserControl.Resources>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RowDefinitions="*,Auto">
        <!-- Row 0: Scrollable content area (article cards and page image) -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" Spacing="12" VerticalAlignment="Stretch">
                <!-- Article Cards Container - Shows all articles that contain the current page -->
                <StackPanel Name="ArticleCardsContainer" Spacing="8">
                    <!-- Article cards will be dynamically added here -->
                </StackPanel>

                <!-- Transient toast for short messages (fades out) -->
                <Border Name="ToastBorder" Background="#CC000000" CornerRadius="6" Padding="8" HorizontalAlignment="Center" IsVisible="False" Opacity="1" Margin="0,6,0,0">
                    <TextBlock Name="ToastText" Foreground="White" FontWeight="Bold" FontSize="12" />
                </Border>

                <!-- Page image (full width) with overlay message when missing -->
                <Border Background="#FFFFFF" CornerRadius="4" Padding="4" Name="PageImageBorder" Margin="0,0,0,12">
                    <Grid>
                        <!-- Bind MaxWidth to the Border's bounds so the image will never exceed the pane width; Stretch="Uniform" preserves aspect ratio.
                             StretchDirection="DownOnly" avoids upscaling so the image is only reduced to fit the width. Center horizontally. -->
                        <Image Name="PageImage" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center"
                               MaxWidth="{Binding Path=Bounds.Width, ElementName=PageImageBorder}" 
                               DoubleTapped="OnImageDoubleTapped"
                               Cursor="Hand" />
                        <TextBlock Name="ImageMissingText" Text="Page image not found" Foreground="Red" Background="#80FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" Padding="8"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Row 1: Fixed Page Navigation Controls at bottom -->
        <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="12">
            <Grid ColumnDefinitions="*,Auto,*">
                <!-- Page Navigation Controls (center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button Name="PrevPageBtn" Content="◀" Width="36" Height="36" Background="White" Foreground="Black"/>
                    <TextBox Name="PageInput" Text="8" Width="80" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Background="White" Foreground="Black"/>
                    <Button Name="NextPageBtn" Content="▶" Width="36" Height="36" Background="White" Foreground="Black"/>
                </StackPanel>
                
                <!-- Link Indicator (right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4" Name="LinkIndicator" IsVisible="False">
                    <TextBlock Text="🔗" FontSize="18" VerticalAlignment="Center">
                        <ToolTip.Tip>
                            <Border Background="#F5F5F5" BorderBrush="#999" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Name="LinkTooltipContent" Spacing="4">
                                    <!-- Links will be populated dynamically -->
                                    <TextBlock Text="Links found on this page:" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </ToolTip.Tip>
                    </TextBlock>
                    <TextBlock Name="LinkCount" Text="" FontSize="12" VerticalAlignment="Center" Foreground="#666" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
