@{
    ViewData["Title"] = "The Archive - Database Test";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4">The Archive</h1>
        <p class="lead">Magazine Collection Viewer - Database Test</p>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Database Connection Status</h3>
        </div>
        <div class="card-body">
            <p class="alert @(ViewBag.MagazineCount > 0 ? "alert-success" : "alert-danger")">
                @ViewBag.Status
            </p>
            
            @if (ViewBag.MagazineCount > 0)
            {
                <h4>Magazines Found: @ViewBag.MagazineCount</h4>
                <table class="table table-striped mt-3">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Issue Count</th>
                            <th>Slug</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mag in ViewBag.Magazines)
                        {
                            <tr>
                                <td>@mag.MagazineId</td>
                                <td>@mag.Name</td>
                                <td>@mag.IssueCount</td>
                                <td><code>@mag.Id</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
                
                <hr class="my-4" />
                
                <h4>API Endpoints Test</h4>
                <div class="list-group">
                    <a href="/api/v1/magazines" class="list-group-item list-group-item-action" target="_blank">
                        <strong>GET /api/v1/magazines</strong> - List all magazines
                    </a>
                    <a href="/api/v1/issues" class="list-group-item list-group-item-action" target="_blank">
                        <strong>GET /api/v1/issues</strong> - List all issues
                    </a>
                    <a href="/api/v1/models" class="list-group-item list-group-item-action" target="_blank">
                        <strong>GET /api/v1/models</strong> - List all models
                    </a>
                    <a href="/api/v1/articles" class="list-group-item list-group-item-action" target="_blank">
                        <strong>GET /api/v1/articles</strong> - List all articles
                    </a>
                </div>
            }
        </div>
    </div>
</div>
