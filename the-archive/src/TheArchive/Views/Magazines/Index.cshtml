@{
    ViewData["Title"] = ViewBag.Magazine.Name;
}

<div class="main fade-in">
    <div class="section-hd">
        <div>
            <h1 class="section-title">@ViewBag.Magazine.Name</h1>
            <p class="section-sub">All issues</p>
        </div>
        <span class="count-badge">@ViewBag.Issues.Count Issue@(ViewBag.Issues.Count != 1 ? "s" : "")</span>
    </div>

    <div class="issue-grid">
        @foreach (var issue in ViewBag.Issues)
        {
            var magazineClass = ViewBag.Magazine.Id.ToLower().Replace(" ", "-");
            <a class="issue-card" href="/issues/@issue.IssueId">
                <div class="issue-thumb @magazineClass lazy-bg" 
                     data-bg-url="@(string.IsNullOrEmpty(issue.CoverImagePath) ? "" : $"/image?path={Uri.EscapeDataString(issue.CoverImagePath)}")">
                    <div class="loading-spinner"></div>
                </div>
                <div class="issue-info">
                    <div class="issue-num">@ViewBag.Magazine.Name</div>
                    <div class="issue-vol">@issue.VolumeDisplay</div>
                    <div class="issue-date">@issue.DateLabel</div>
                    <div class="issue-art-count">@issue.ArticleCount article@(issue.ArticleCount != 1 ? "s" : "")</div>
                </div>
            </a>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Lazy load background images using Intersection Observer
        document.addEventListener('DOMContentLoaded', function() {
            const lazyBackgrounds = document.querySelectorAll('.lazy-bg');
            
            const imageObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const div = entry.target;
                        const bgUrl = div.getAttribute('data-bg-url');
                        
                        if (bgUrl) {
                            // Preload the image
                            const img = new Image();
                            img.onload = () => {
                                div.style.backgroundImage = `url('${bgUrl}')`;
                                div.style.backgroundSize = 'contain';
                                div.style.backgroundPosition = 'center';
                                div.style.backgroundRepeat = 'no-repeat';
                                div.classList.add('loaded');
                                div.querySelector('.loading-spinner').style.display = 'none';
                            };
                            img.src = bgUrl;
                        }
                        
                        observer.unobserve(div);
                    }
                });
            }, {
                rootMargin: '50px' // Start loading 50px before the element is visible
            });
            
            lazyBackgrounds.forEach(bg => {
                imageObserver.observe(bg);
            });
        });
    </script>
}
