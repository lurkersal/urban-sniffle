@model List<TheArchive.Models.Article>
@{
    ViewData["Title"] = "Articles";
}

<div class="main fade-in">
    <div class="section-hd">
        <div>
            <h1 class="section-title">All <em>Articles</em></h1>
            <p class="section-sub">Browse all magazine articles</p>
        </div>
        <span class="count-badge">@Model.Count @(Model.Count != 1 ? "Articles" : "Article")</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <p>No articles found.</p>
        </div>
    }
    else
    {
        <div class="article-list">
            @foreach (var article in Model)
            {
                <a class="article-item" href="/articles/@article.ArticleId">
                    <div class="article-header">
                        <h3 class="article-title">@(article.Title ?? "Untitled")</h3>
                        <span class="article-category">@article.CategoryName</span>
                    </div>
                    <div class="article-meta">
                        @if (!string.IsNullOrEmpty(article.ModelName))
                        {
                            <span class="article-model">Model: @article.ModelName</span>
                        }
                        @if (!string.IsNullOrEmpty(article.Photographer))
                        {
                            <span class="article-photographer">📷 @article.Photographer</span>
                        }
                        <span class="article-page">Page @article.PageStart</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

<style>
    .article-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 1000px;
        margin: 0 auto;
    }
    
    .article-item {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 1.5rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.2s ease;
    }
    
    .article-item:hover {
        border-color: #667eea;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.15);
        transform: translateY(-2px);
    }
    
    .article-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 0.75rem;
        gap: 1rem;
    }
    
    .article-title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        color: #333;
        flex: 1;
    }
    
    .article-category {
        background: #667eea;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.85rem;
        white-space: nowrap;
    }
    
    .article-meta {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        font-size: 0.9rem;
        color: #666;
    }
    
    .article-meta > span {
        display: flex;
        align-items: center;
    }
    
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #999;
    }
</style>

