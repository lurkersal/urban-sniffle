@{
    ViewData["Title"] = ViewBag.Model.Name;
}

<div class="main fade-in">
    <div class="model-detail">
        <div>
            <div class="model-portrait">
                @if (!string.IsNullOrEmpty(ViewBag.ModelThumbnail))
                {
                    <img src="/image?path=@Uri.EscapeDataString(ViewBag.ModelThumbnail)" 
                         alt="@ViewBag.Model.Name" 
                         class="model-portrait-image" />
                }
                else
                {
                    var modelName = ViewBag.Model.Name as string;
                    var nameWords = modelName.Split(' ');
                    var initials = string.Join("", nameWords.Select(w => w.Length > 0 ? w[0].ToString() : ""));
                    <div class="model-portrait-initials">@initials</div>
                }
                <div class="model-portrait-name">@ViewBag.Model.Name</div>
            </div>
        </div>
        
        <div class="model-stats">
            <div>
                <div class="stat-group-label">Profile</div>
                @if (!string.IsNullOrEmpty(ViewBag.Model.Measurements))
                {
                    <div class="stat-row">
                        <span class="stat-label">Measurements</span>
                        <span class="stat-val">@ViewBag.Model.Measurements</span>
                    </div>
                }
                @if (ViewBag.Model.YearOfBirth != null && ViewBag.Model.YearOfBirth.HasValue)
                {
                    <div class="stat-row">
                        <span class="stat-label">Year of Birth</span>
                        <span class="stat-val">@ViewBag.Model.YearOfBirth</span>
                    </div>
                }
                <div class="stat-row">
                    <span class="stat-label">Appearances</span>
                    <span class="stat-val">@ViewBag.Model.AppearanceCount</span>
                </div>
            </div>
            
            @if (ViewBag.Issues != null && ViewBag.Issues.Count > 0)
            {
                <div>
                    <div class="stat-group-label">Appearances (@ViewBag.Issues.Count issue@(ViewBag.Issues.Count != 1 ? "s" : ""))</div>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem;">
                        @foreach (var issue in ViewBag.Issues)
                        {
                            <a class="appearance-chip" href="/issues/@issue.IssueId">
                                <span class="chip-mag">@issue.MagazineName</span>
                                <span>@issue.DateLabel</span>
                            </a>
                        }
                    </div>
                </div>
            }
            
            @if (ViewBag.Articles != null && ViewBag.Articles.Count > 0)
            {
                <div>
                    <div class="stat-group-label">Articles (@ViewBag.Articles.Count)</div>
                    <div class="article-list" style="margin-top: 0.5rem;">
                        @{
                            var articles = ViewBag.Articles as List<TheArchive.Models.Article>;
                            var articlesToShow = articles.Take(10);
                        }
                        @foreach (var article in articlesToShow)
                        {
                            var catClass = "cat-" + article.Category;
                            <div class="article-row" style="padding: 8px 0;" onclick="window.location.href='/issues/@article.IssueId'">
                                <div class="article-pg" style="font-size: 16px;">@article.PageStart</div>
                                <div class="article-body">
                                    <div>
                                        <span class="article-cat @catClass">@article.CategoryName</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(article.Title))
                                    {
                                        <div class="article-title" style="font-size: 14px;">@article.Title</div>
                                    }
                                    else
                                    {
                                        <div class="article-title" style="font-size: 14px; color: var(--muted); font-style: italic;">Untitled</div>
                                    }
                                </div>
                                <div style="font-size: 11px; color: var(--muted);">Issue @article.IssueId</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

