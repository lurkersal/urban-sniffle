@model List<TheArchive.Models.Contributor>
@{
    ViewData["Title"] = "Photographers";
}

<div class="main fade-in">
    <div class="section-hd">
        <div>
            <h1 class="section-title">The <em>Photographers</em></h1>
            <p class="section-sub">Contributors across all magazines</p>
        </div>
        <span class="count-badge">@Model.Count @(Model.Count != 1 ? "Photographers" : "Photographer")</span>
    </div>

    <div class="photographer-grid">
        @foreach (var photographer in Model)
        {
            var initials = string.Join("", photographer.Name.Split(' ').Select(w => w.Length > 0 ? w[0].ToString() : ""));
            <a class="photographer-card" href="/photographers/@photographer.Slug">
                <div class="photographer-photo">
                    <div class="photographer-initials">@initials</div>
                    <div class="photographer-name-overlay">@photographer.Name</div>
                </div>
                <div class="photographer-info">
                    <div class="photographer-name">@photographer.Name</div>
                    <div class="photographer-appear">@photographer.AppearanceCount @(photographer.AppearanceCount != 1 ? "appearances" : "appearance")</div>
                </div>
            </a>
        }
    </div>
</div>

<style>
    .photographer-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1.5rem;
        padding: 1rem;
    }
    
    .photographer-card {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: all 0.2s ease;
    }
    
    .photographer-card:hover {
        border-color: #667eea;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.15);
        transform: translateY(-2px);
    }
    
    .photographer-photo {
        position: relative;
        aspect-ratio: 1;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .photographer-initials {
        font-size: 3rem;
        font-weight: bold;
        color: white;
        opacity: 0.9;
    }
    
    .photographer-name-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 0.5rem;
        font-size: 0.9rem;
        text-align: center;
    }
    
    .photographer-info {
        padding: 1rem;
    }
    
    .photographer-name {
        font-weight: 600;
        margin-bottom: 0.25rem;
        font-size: 1.1rem;
    }
    
    .photographer-appear {
        font-size: 0.85rem;
        color: #666;
    }
</style>

